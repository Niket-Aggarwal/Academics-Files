	<Test name="if(AC[0]==0)" register="model.module.Register4cdd57c9" start="0" numBits="1" comparison="NE" value="0" omission="1" id="model.microinstruction.Test62a81d73" />
	<Test name="if(AC[0]==1)" register="model.module.Register4cdd57c9" start="0" numBits="1" comparison="NE" value="1" omission="1" id="model.microinstruction.Test111b54ff" />
	<Test name="if(E==0)" register="model.module.Register52e8f8b8" start="0" numBits="1" comparison="NE" value="0" omission="1" id="model.microinstruction.Test28aaaed7" />

