	<TransferRtoR name="E-&gt;TE" source="model.module.Register52e8f8b8" srcStartBit="0" dest="model.module.Register30e139e8" destStartBit="0" numBits="1" id="model.microinstruction.TransferRtoR62ca6262" />
	<TransferRtoR name="PC-&gt;AR" source="model.module.Register662743f9" srcStartBit="0" dest="model.module.Register11c06b04" destStartBit="0" numBits="12" id="model.microinstruction.TransferRtoR2585df4f" />
	<TransferRtoR name="TE-&gt;AC[0]" source="model.module.Register30e139e8" srcStartBit="0" dest="model.module.Register4cdd57c9" destStartBit="0" numBits="1" id="model.microinstruction.TransferRtoR5d37f66f" />
	<TransferRtoR name="TE-&gt;AC[15]" source="model.module.Register30e139e8" srcStartBit="0" dest="model.module.Register4cdd57c9" destStartBit="15" numBits="1" id="model.microinstruction.TransferRtoR6d257b73" />

