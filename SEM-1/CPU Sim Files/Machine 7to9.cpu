		<Microinstruction microRef="model.microinstruction.End5e25a7e3" />
	</FetchSequence>

	<!--............. machine instructions ..........-->

	<MachineInstruction name="SZE" opcode="d" instructionFormat="OP UNUSED" assemblyFormat="OP" instructionColors="#a4ec89 #82eabb" assemblyColors="#a4ec89" >
