		<Microinstruction microRef="model.microinstruction.End7f50208d" />
	</MachineInstruction>

	<MachineInstruction name="write" opcode="1" instructionFormat="OP UNUSED" assemblyFormat="OP" instructionColors="#cd93fe #c1b8ca" assemblyColors="#cd93fe" >
