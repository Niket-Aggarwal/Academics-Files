	<MemoryAccess name="DR-&gt;MAIN[AR]" direction="write" memory="model.module.RAM6b5b1072" data="model.module.Register1228646f" address="model.module.Register6ad6dad4" id="model.microinstruction.MemoryAccess591f22ae" />
	<MemoryAccess name="MAIN[AR]-&gt;DR" direction="read" memory="model.module.RAM6b5b1072" data="model.module.Register1228646f" address="model.module.Register6ad6dad4" id="model.microinstruction.MemoryAccess7f2dc549" />
	<MemoryAccess name="MAIN[AR]-&gt;IR" direction="read" memory="model.module.RAM6b5b1072" data="model.module.Register3ad5470c" address="model.module.Register6ad6dad4" id="model.microinstruction.MemoryAccess146020a2" />

	<!--............. end ...........................-->
