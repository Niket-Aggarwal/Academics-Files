		<Microinstruction microRef="model.microinstruction.Decode3e8fbba7" />
		<Microinstruction microRef="model.microinstruction.End7f50208d" />
	</FetchSequence>

	<!--............. machine instructions ..........-->

	<MachineInstruction name="xor" opcode="e" instructionFormat="OP UNUSED" assemblyFormat="OP" instructionColors="#8a89bc #9e9ef9" assemblyColors="#8a89bc" >
		<Microinstruction microRef="model.microinstruction.Logical6f124cfc" />
		<Microinstruction microRef="model.microinstruction.End7f50208d" />
	</MachineInstruction>

	<MachineInstruction name="nor" opcode="d" instructionFormat="OP UNUSED" assemblyFormat="OP" instructionColors="#e0b6d5 #f48f87" assemblyColors="#e0b6d5" >
