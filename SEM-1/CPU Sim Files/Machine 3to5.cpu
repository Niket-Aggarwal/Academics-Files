	<TransferRtoR name="AC-&gt;TR" source="model.module.Register74da425" srcStartBit="0" dest="model.module.Register6add9925" destStartBit="0" numBits="16" id="model.microinstruction.TransferRtoR6fba3aaa" />
	<TransferRtoR name="IR[4-15]-&gt;AR" source="model.module.Register3ad5470c" srcStartBit="4" dest="model.module.Register6ad6dad4" destStartBit="0" numBits="12" id="model.microinstruction.TransferRtoR655f57ad" />
	<TransferRtoR name="PC-&gt;AR" source="model.module.Register66892af8" srcStartBit="0" dest="model.module.Register6ad6dad4" destStartBit="0" numBits="12" id="model.microinstruction.TransferRtoR54eec880" />

	<!--............. transferRtoA ..................-->
	<!-- none -->

