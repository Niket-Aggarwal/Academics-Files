		<Microinstruction microRef="model.microinstruction.End7f50208d" />
	</MachineInstruction>

	<MachineInstruction name="and" opcode="9" instructionFormat="OP UNUSED" assemblyFormat="OP" instructionColors="#caceb5 #a9f0a8" assemblyColors="#caceb5" >
