		<Microinstruction microRef="model.microinstruction.End7f50208d" />
	</MachineInstruction>

	<MachineInstruction name="inputTEMP" opcode="8" instructionFormat="OP UNUSED" assemblyFormat="OP" instructionColors="#aefdbc #f3fd9b" assemblyColors="#aefdbc" >
