		<Microinstruction microRef="model.microinstruction.End7f50208d" />
	</MachineInstruction>

	<MachineInstruction name="nand" opcode="c" instructionFormat="OP UNUSED" assemblyFormat="OP" instructionColors="#b4a0ea #ecc9d8" assemblyColors="#b4a0ea" >
