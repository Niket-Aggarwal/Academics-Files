	<Register name="ST" width="3" initialValue="0" readOnly="false" id="model.module.Register3753215a" />
	<Register name="TE" width="1" initialValue="0" readOnly="false" id="model.module.Register7a205c4a" />
	<Register name="TR" width="16" initialValue="0" readOnly="false" id="model.module.Register6add9925" />

	<!--............. register arrays ...............-->
	<!-- none -->

	<!--............. condition bits ................-->
