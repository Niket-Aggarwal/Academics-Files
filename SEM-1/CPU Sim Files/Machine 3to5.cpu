	<Logical name="(TR | DR)'" type="NOR" source1="model.module.Register6add9925" source2="model.module.Register1228646f" destination="model.module.Register74da425" id="model.microinstruction.Logical14b5e2eb" />
	<Logical name="(TR&amp;DR)'" type="NAND" source1="model.module.Register6add9925" source2="model.module.Register1228646f" destination="model.module.Register74da425" id="model.microinstruction.Logical5798bdc1" />
	<Logical name="NOT TR" type="NOT" source1="model.module.Register6add9925" source2="model.module.Register6add9925" destination="model.module.Register74da425" id="model.microinstruction.Logical1f35d592" />
	<Logical name="TR | DR" type="OR" source1="model.module.Register6add9925" source2="model.module.Register1228646f" destination="model.module.Register74da425" id="model.microinstruction.Logical46ef80ba" />
	<Logical name="TR&amp;DR" type="AND" source1="model.module.Register6add9925" source2="model.module.Register1228646f" destination="model.module.Register74da425" id="model.microinstruction.Logical7df68036" />
	<Logical name="TR^DR" type="XOR" source1="model.module.Register6add9925" source2="model.module.Register1228646f" destination="model.module.Register74da425" id="model.microinstruction.Logical6f124cfc" />

